
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own data and read other users' data for leaderboards.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Users can read/write their own quiz attempts.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // The live leaderboard document can be read by anyone, but not written to by clients.
    // Writes are handled securely through backend transactions.
    match /leaderboard/currentQuiz {
        allow read: if true;
        allow write: if false;
    }

    // Authenticated users need to read the question bank to avoid repeats and
    // write newly generated questions back to the bank.
    match /askedQuestions/{questionId} {
      allow read, create: if request.auth != null;
    }
  }
}
