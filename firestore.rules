
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all reads and writes to prevent unintended access
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read on user profiles for leaderboards, but only allow a user to edit their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Quiz history is private to the user
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow public read on live leaderboard entries
    match /leaderboard_live/{slotId}/entries/{userId} {
      allow read: if true;
      // Allow a user to create or update their own entry
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow public read for global stats
    match /globals/stats {
      allow read: if true;
      // Allow any authenticated user to update the global stats (e.g., incrementing a counter)
      allow write: if request.auth != null;
    }
    
    // Allow any authenticated user to submit a contribution
    match /userContributions/{contributionId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // Allow any authenticated user to report a question
     match /reportedQuestions/{reportId} {
        allow create: if request.auth != null;
     }
  }
}
