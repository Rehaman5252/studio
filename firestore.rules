
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 👤 User profile + quiz attempts
    match /users/{userId} {
      // ✅ All logged-in users can read any profile (for leaderboard)
      allow read: if request.auth != null;

      // ✅ Only owner can write to their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // ✅ Quiz attempts stored as subcollection under each user
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ❓ Public questions
    match /questions/{questionId} {
      allow read: if true;
    }

    // ✅ Shared quizAttempts collection (if also used globally)
    match /quizAttempts/{docId} {
      allow create, read: if request.auth != null;
    }

    // ⏳ Slot uniqueness
    match /slots/{slotId} {
      allow read, write: if request.auth != null;

      // Subcollection for used questions in this slot (if used)
      match /usedQuestions/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // 🏆 Leaderboards
    match /leaderboard/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 🚫 Deny everything else that isn't explicitly allowed.
    // This is a good security practice.
    // NOTE: This rule is commented out as it was causing issues with other unlisted collections.
    // A more granular approach is taken above.
    // match /{document=**} {
    //   allow read, write: if false;
    // }
  }
}
