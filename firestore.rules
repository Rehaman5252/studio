rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows ANYONE to read ANY document in the `users` collection.
    // This is required for the All-Time leaderboard which queries the top users.
    // It also allows any authenticated user to write ONLY to their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // This rule allows ANYONE to read ANY quiz attempt from ANY user.
      // This is required for the Live Leaderboard which uses a collectionGroup query
      // to find all attempts for the current slot across all users.
      // It allows an authenticated user to write ONLY to their own quiz attempts.
      match /quizAttempts/{attemptId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
