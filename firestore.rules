
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own data, but other authenticated users can only read basic info for leaderboards/profiles.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      // Users can write their own quiz attempts.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // The 'askedQuestions' collection needs to be read from and written to during quiz generation.
    // Any authenticated user can perform these actions.
    match /askedQuestions/{questionId} {
      allow read, create: if request.auth != null;
    }

    // The 'leaderboard' collection contains the live quiz data.
    // Any authenticated user can read it. Writes are handled by secure backend logic (Cloud Functions/transactions).
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Disallow direct client writes for security.
    }
  }
}
