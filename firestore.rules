rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read access to global stats
    match /globals/stats {
      allow read: if true;
      // Allow authenticated users to write to the known numeric fields.
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(["totalQuizzesPlayed", "totalPerfectScores"])
        && request.resource.data.totalQuizzesPlayed is number
        && request.resource.data.totalPerfectScores is number;
    }

    // Rules for the users collection
    match /users/{userId} {
      // Publicly readable for leaderboards
      allow read: if true;
      
      // A user can create their own document
      allow create: if request.auth != null && request.auth.uid == userId;

      // A user can update their own document, but only specific fields
      allow update: if request.auth != null && request.auth.uid == userId;
      
      // A user cannot delete their own document
      allow delete: if false;

      // Rules for the quizAttempts subcollection
      match /quizAttempts/{attemptId} {
        // A user can read their own quiz attempts
        allow read: if request.auth != null && request.auth.uid == userId;

        // A user can create their own quiz attempt
        allow create: if request.auth != null && request.auth.uid == userId;

        // A user cannot update or delete past attempts
        allow update, delete: if false;
      }
    }

    // Rules for the live leaderboard entries
    match /leaderboard_live/{slotId}/entries/{userId} {
      // Leaderboard is public
      allow read: if true;
      
      // A user can create or update their own entry
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for user-submitted content
    match /userContributions/{contributionId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
    
    // Rules for reported questions
    match /reportedQuestions/{reportId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
