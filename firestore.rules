
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Globals collection for app-wide stats
    match /globals/stats {
      // Allow any authenticated user to increment stats.
      // For production, you might restrict this to a server-side process.
      allow write: if request.auth != null;
      allow read: if true;
    }
    
    // User-specific data
    match /users/{userId} {
      // Users can read their own profile, and it is publicly readable for leaderboards
      allow read: if true;
      
      // Users can create their own document, and update it if they are the owner.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Quiz attempts subcollection
      match /quizAttempts/{slotId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Live leaderboard entries for each slot
    match /leaderboard_live/{slotId}/entries/{userId} {
      // Anyone can read the live leaderboard
      allow read: if true;
      // Only the authenticated user can write their own entry
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User-submitted content
    match /userContributions/{contributionId} {
      allow read: if true; // Allow reading contributions
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Reported questions
    match /reportedQuestions/{reportId} {
       allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}
