
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // This rule allows anyone to read any user's profile information.
    // This is required for the All-Time and My Network leaderboards to fetch player names and avatars.
    // It also allows a collection group query on quizAttempts to power the live leaderboard.
    match /users/{userId} {
      allow read: if true;

      // Users can only write to their own documents.
      allow write: if request.auth != null && request.auth.uid == userId;

      // This rule allows anyone to read the quiz attempts of any user, which is necessary
      // for the Live Leaderboard to function. Writes are still protected.
      match /quizAttempts/{attemptId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
