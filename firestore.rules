rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile, attempts, and status
    match /users/{userId} {
      // Allow any authenticated user to read user profiles (for leaderboards, etc.)
      allow read: if request.auth != null;
      // Allow a user to write to their own document only
      allow write: if request.auth.uid == userId;

      // Allow a user to manage their own quiz attempts
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth.uid == userId;
      }

      // Allow a user to manage their own status documents
      match /quizStatus/{statusId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Leaderboard is public read-only for clients
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Only backend/admin can write
    }

    // Allow authenticated users to query, read, and create asked questions
    match /askedQuestions/{questionId} {
      allow list, read, create: if request.auth != null;
      // Do not allow updates or deletes from client
      allow update, delete: if false;
    }

    // Quizzes are read-only for clients; only admins can write them
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.admin == true;
    }

    // Deny all other reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
