
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access to prevent unintentional open collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read for global stats
    match /globals/stats {
      allow read: if true;
      // Allow writes only from authenticated users to increment counters
      // For more security, this could be moved to a Cloud Function.
      allow write: if request.auth != null;
    }

    // User profiles can be read by anyone (for leaderboards),
    // but only the owner can create or update their own document.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;

      // Quiz attempts are private to the user.
      // A user can only create their own attempt documents.
      match /quizAttempts/{attemptId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        // prevent history from being changed
        allow update, delete: if false;
      }
    }
    
    // Live leaderboard entries can be read by anyone.
    // A user can only create or update their own entry, identified by their UID.
    match /leaderboard_live/{slotId}/entries/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
    }

    // User contributions can be created by any authenticated user.
    // Reading/updating/deleting would typically be handled by admin roles, not covered here.
    match /userContributions/{contributionId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false; // Only admin/backend access
    }

    // Reported questions can be created by any authenticated user.
    match /reportedQuestions/{reportId} {
        allow create: if request.auth != null;
        allow read, update, delete: if false; // Only admin/backend access
    }
  }
}
