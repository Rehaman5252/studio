
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Users can read and write their own profile data.
    // Any authenticated user can read public user data for leaderboards.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      // Users can write their own quiz attempts.
      // They can also read their own past attempts.
      match /quizAttempts/{attemptId} {
        allow read, create: if request.auth.uid == userId;
        allow update, delete: if false; // Attempts should be immutable
      }
    }

    // The live leaderboard can be read by any authenticated user.
    // Writes are handled by the transaction in the addQuizAttempt flow.
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Allow writes from authenticated users (via transaction)
    }

    // Allow authenticated reads and creates for the question bank
    // to prevent quiz question repetition.
    match /askedQuestions/{questionId} {
        allow read, create: if request.auth != null;
    }

    // Deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
