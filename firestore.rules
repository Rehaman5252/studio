
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Leaderboard access
    match /leaderboard/{docId} {
      allow read: if true; // Allow public read
      allow write: if false; // Block all public writes
    }

    // Users collection and subcollections
    match /users/{userId}/{documents=**} {
      allow read: if true; // Allow public read for profiles and quiz attempts
      allow write: if request.auth != null && request.auth.uid == userId; // Only allow a user to write to their own documents
    }
  }
}
