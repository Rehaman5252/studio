rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // user can update their own stats & profile
      allow update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // quiz attempts (subcollection)
      match /quizAttempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Live leaderboard
    match /leaderboard_live/{slotId}/entries/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    // Global stats
    match /globals/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // consider restricting later
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}