
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null; // Allow any authenticated user to read user profiles for leaderboards
      allow write: if request.auth.uid == userId;
    }

    // Any authenticated user can read/write their own quiz history.
    match /users/{userId}/quizAttempts/{attemptId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // The live leaderboard can be read by anyone, but only written to by authenticated users.
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
