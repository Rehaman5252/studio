
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }
    
    // Users can only read/write their own quiz attempts
    match /users/{userId}/quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can only write their own entry to the live leaderboard
    match /leaderboard_live/{slotId}/entries/{userId} {
        allow create, update: if request.auth != null && request.auth.uid == userId;
        // All authenticated users can read the leaderboard
        allow list, get: if request.auth != null;
    }

    // Global stats can be read by anyone, but only updated by server-side logic (not enforced here, done via secure functions)
    match /globals/stats {
      allow get: if true;
      allow write: if false; // Should be written from a trusted backend
    }
    
    // User contributions can be created by any auth'd user, but only read by owner or admin
    match /userContributions/{docId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId; // Or admin role
    }
  }
}
