
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Users can only read/write their OWN document.
    // This protects private information like email, phone, etc.
    match /users/{userId} {
      allow write: if request.auth.uid == userId;
      // Authenticated users can read public profile info for leaderboards.
      // NOTE: Ensure any sensitive data is not publicly exposed by client-side code.
      allow read: if request.auth != null;
    }

    // A user can read/write their own quiz attempts.
    match /users/{userId}/quizAttempts/{attemptId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // The live leaderboard is public for anyone to read.
    // Writes should only be handled by secure backend functions or transactions.
    match /leaderboard/currentQuiz {
      allow read: if true;
      allow write: if false; // Protect from direct client writes
    }
    
    // Health check document for testing connectivity
    match /health-check/status {
      allow read: if true;
      allow write: if false;
    }
  }
}
