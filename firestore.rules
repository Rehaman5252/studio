
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 👤 User profile & subcollections
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // 📜 Subcollection: quizAttempts
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // 📅 Subcollection: dailyActivity for streaks
      match /dailyActivity/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ❓ Public quiz questions
    match /questions/{questionId} {
      allow read: if true;
    }
    
    // Allow querying the questions collection
    match /questions {
      allow list: if request.auth != null;
    }

    // ✅ Shared quizAttempts collection (if used globally)
    match /quizAttempts/{docId} {
      allow read, create: if request.auth != null;
    }

    // 📆 Corrected quiz slot metadata path
    match /quizSlots/{slotId} {
      allow read, write: if request.auth != null;
    }

    // 🏆 Corrected leaderboard path
    match /leaderboard/currentQuiz {
      allow read: if true;
      // Allow authenticated users to add/update their own scores
      allow write: if request.auth != null;
    }

    // 🚫 Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
