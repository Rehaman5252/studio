
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only write to their own document, but any authenticated
    // user can read public data for leaderboards.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Rules for the 'quizAttempts' subcollection within each user's document.
      // A user can read and write to their own quiz history.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // The global 'questions' collection can be read by any authenticated user.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      // Writes should be handled by a backend process/admin SDK.
      allow write: if false; 
    }

    // The 'quizSlots' collection stores which questions have been used in a slot.
    // Any authenticated user can read/write to this to participate in a quiz.
    match /quizSlots/{slotId} {
      allow read, write: if request.auth != null;
    }

    // The 'leaderboard' collection holds the current quiz's live standings.
    // Any authenticated user can read it. A user can only write their own entry.
    match /leaderboard/currentQuiz {
       allow read: if request.auth != null;
       // Allow writes so players can be added to the leaderboard array.
       // More specific rules could be added to the 'players' array if needed.
       allow write: if request.auth != null;
    }
    
    // Fallback rule: deny all other access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
