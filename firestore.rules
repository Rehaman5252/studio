
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access to user profiles for leaderboards
    // but only allow the user themselves to write to their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow users to read their own quiz attempts and create new ones.
      // Collection group queries for the live leaderboard need broader read access.
      match /quizAttempts/{attemptId} {
        allow read: if true; // Allow public read for live leaderboard
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // This is required for the Firestore health check to work for unauthenticated users.
    match /health-check/{docId} {
        allow read, write: if true;
    }
  }
}
