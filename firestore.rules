
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles can be read by any authenticated user (for leaderboards),
    // but only the owner can write to their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // A user can only access their own quiz attempts subcollection.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Questions can be read individually or as a collection by any authenticated user.
    // This is required for the quiz generation flow to query for questions.
    match /questions/{questionId} {
      allow read: if request.auth != null;
    }

    // Any authenticated user can read or write to quiz slot documents to track
    // which questions have been used in a given time slot.
    match /quizSlots/{slotId} {
      allow read, write: if request.auth != null;
    }

    // The live leaderboard document can be read by anyone, and written to by
    // any authenticated user to update their score.
    match /leaderboard/currentQuiz {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default deny all other access to prevent unauthorized operations.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
