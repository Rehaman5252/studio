
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access to leaderboards, but only allow admin writes.
    // In a real app, you would have a mechanism to verify admin status.
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if request.auth != null; // Simplified for now
    }

    // Users can read their own profile, and anyone can read limited public profiles.
    // Users can only write to their own profile.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Quiz attempts can be written by the user, and read publicly for leaderboards.
      match /quizAttempts/{attemptId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
