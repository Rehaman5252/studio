rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can read/write their own data, but others can read limited fields for leaderboards
    match /users/{userId} {
      allow read: if request.auth != null; // For leaderboards
      allow write: if request.auth.uid == userId; // For profile updates
    }

    // Quiz history is private to the user
    match /users/{userId}/quizAttempts/{attemptId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Leaderboard is read-only for authenticated users
    match /leaderboard/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // Only backend/transactions should write here
    }

    // Anyone authenticated can query (list), read, and create from the question bank
    match /askedQuestions/{questionId} {
      allow list, read, create: if request.auth != null;
    }
  }
}
