rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own profile, and only update their own profile.
    match /users/{userId} {
      // Allow reads for authenticated users to see their own profile and for leaderboards.
      allow read: if request.auth != null;
      // Allow users to create their own document.
      allow create: if request.auth.uid == userId;
      // Allow users to update their own document.
      allow update: if request.auth.uid == userId;
      // Deletes are not allowed.
      allow delete: if false;

      // Quiz attempts are private to the user.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Live leaderboard entries can be read by anyone, but only created/updated by the user themselves.
    match /leaderboard_live/{slotId}/entries/{userId} {
      allow read: if true;
      allow create, update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // User-submitted content can be read by anyone, but only created by authenticated users.
    match /userContributions/{contributionId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow update, delete: if false; // Managed by backend/admins
    }
    
    // Reported questions are write-only for users.
    match /reportedQuestions/{reportId} {
        allow read, update, delete: if false; // Managed by backend/admins
        allow create: if request.auth != null;
    }

    // Global stats are publicly readable, but not writable by clients.
    match /globals/{docId} {
      allow read: if true;
      allow write: if false; // Should only be updated by server-side logic/batch writes.
    }
  }
}
