rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows any client to read user profiles and quiz attempts.
    // This is necessary for the public leaderboards to function.
    // Writes are still protected.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /quizAttempts/{attemptId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
