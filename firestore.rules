
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the request is from the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can read/write their own data, but cannot delete their main document.
    // They can also be created by anyone signing up.
    match /users/{userId} {
      allow read, update, write: if isOwner(userId);
      allow create: if isAuthenticated();

      // Users can only manage their own subcollections
      match /quizAttempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }
      match /dailyActivity/{activityId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Any authenticated user can read the list of questions.
    // Writes should be handled by a secure backend process (like a Cloud Function or Admin SDK).
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if false; // Lock down direct client writes for now
    }
    
    // Any authenticated user can write a report.
    match /reportedQuestions/{reportId} {
        allow create: if isAuthenticated();
    }

    // Any authenticated user can read leaderboard data.
    // Writes to the leaderboard are handled by server-side logic (transactions)
    // which bypasses these rules when initiated from a trusted environment.
    match /leaderboard/{docId} {
        allow read: if isAuthenticated();
        allow write: if false; // Prevent clients from writing directly to the leaderboard
    }
    
    // Quiz slots are used to track which questions have been used globally.
    // Authenticated users can read and write to this collection.
    match /quizSlots/{slotId} {
        allow read, write: if isAuthenticated();
    }
  }
}
