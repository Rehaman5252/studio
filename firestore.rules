
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can only read/write their own data.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Quiz attempts are private to the user.
    match /users/{userId}/quizAttempts/{attemptId} {
      allow read, write: if request.auth.uid == userId;
    }
    
    // The live leaderboard is public read, but write is locked down.
    // Writes should only ever happen via server-side logic (transactions in this case).
    match /leaderboard/currentQuiz {
        allow read: if true;
        allow write: if false; // Lock down writes completely
    }
  }
}
