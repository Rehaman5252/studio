rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile, attempts, and status
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Leaderboard is public read only
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // askedQuestions: queried during quiz generation
    match /askedQuestions/{questionId} {
      allow read, write, list: if request.auth != null;
    }

    // quizzes: allow client to read, only admin writes
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
