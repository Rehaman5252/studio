
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public collections (if any) can go here
    // Example: allow public read for a 'posts' collection
    // match /posts/{postId} {
    //   allow read: if true;
    //   allow write: if isSignedIn();
    // }

    // Users can only read and write to their own document.
    // New users can create their own document.
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn();
    }

    // Quiz attempts can only be created, read, or updated by the user who owns them.
    match /users/{userId}/quizAttempts/{attemptId} {
      allow read, write: if isOwner(userId);
    }
  }
}
