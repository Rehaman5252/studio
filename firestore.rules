
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own data.
    // Any authenticated user can read basic data for leaderboards.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      // Users can only write to their own quiz attempts subcollection.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // The live leaderboard can be read by anyone authenticated.
    // Writes are handled by secure server-side transactions.
    match /leaderboard/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // Disallow direct client writes
    }

    // Authenticated users can create questions (via the AI flow)
    // and list them to prevent duplicates.
    match /askedQuestions/{questionId} {
      allow read, list, create: if request.auth != null;
    }
    
    // Default deny all other access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
