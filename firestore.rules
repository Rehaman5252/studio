
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read and update their own profile data.
    // They can only create a document if the new document's ID matches their own UID.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can manage their own quiz attempts and daily activity.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /dailyActivity/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Any authenticated user can read from the questions collection.
    // Writing to this collection should only be done via a trusted server/admin SDK.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect from client-side writes
    }
    
    // Any authenticated user can read the live and all-time leaderboards.
    match /leaderboard/{docId} {
        allow read: if request.auth != null;
        allow write: if false; // Only server can update leaderboards
    }

    // Any authenticated user can read the global quiz stats.
    match /quizSlots/{slotId} {
      allow read: if request.auth != null;
      allow write: if false; // Protect from client-side writes
    }
    
    // Any authenticated user can create a report for a question.
    match /reportedQuestions/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Only admins should manage reports
    }
  }
}
