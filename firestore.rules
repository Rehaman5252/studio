
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow public read access on the users collection for the All-Time Leaderboard.
    // Writes are restricted to the authenticated user modifying their own document.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Allow public read access on the quizAttempts subcollection for the
      // Live Leaderboard's collection group query.
      // Writes are restricted to the authenticated user.
      match /quizAttempts/{attemptId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
