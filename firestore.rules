rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------
    // Globals stats doc: /globals/stats
    // Allow authenticated users to write limited numeric counters.
    // ---------------------------
    match /globals/stats {
      allow read: if true;

      allow write: if request.auth != null
        // allow only numeric increments for known keys
        && request.resource.data.keys().hasOnly(["totalQuizzesPlayed", "totalPerfectScores"])
        && request.resource.data.totalQuizzesPlayed is number
        && request.resource.data.totalPerfectScores is number;
    }

    // ---------------------------
    // Users collection (profiles & stats)
    // /users/{userId}
    // Allow reads publicly (leaderboard) and allow the user to create/update their own doc
    // but restrict what fields they may set.
    // ---------------------------
    match /users/{userId} {
      // Allow public read for leaderboards and profile display
      allow read: if true;

      // Allow create only by that user (initial profile creation)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow update by user if only permitted fields are being changed.
      allow update: if request.auth != null
        && request.auth.uid == userId
        // allowed fields for updates performed by the app batch and profile edits:
        && request.resource.data.diff(resource.data).affectedKeys.hasOnly([
            "name", "phone", "photoURL", "profileCompleted", "guidedTourCompleted",
            "dob", "gender", "occupation", "upi", "favoriteFormat", "favoriteTeam",
            "favoriteCricketer", "phoneVerified", "quizzesPlayed", "totalScore",
            "perfectScores", "totalRewards", "currentStreak", "lastStreakTimestamp",
            "noBallCount", "lastNoBallTimestamp", "updatedAt"
        ]);

      // No client-side deletes
      allow delete: if false;

      // ---------------------------
      // Subcollection: quizAttempts
      // /users/{userId}/quizAttempts/{attemptId}
      // Allow the user to create (write) their own attempt and read their attempts.
      // No client updates/deletes allowed (immutable).
      // ---------------------------
      match /quizAttempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
            && request.auth.uid == userId
            // require that the attempt document contains its userId and slotId
            && ("userId" in request.resource.data)
            && request.resource.data.userId == request.auth.uid
            && ("slotId" in request.resource.data)
            && request.resource.data.slotId is string
            // optional basic type checks
            && ("score" in request.resource.data ? request.resource.data.score is number : true)
            && ("totalQuestions" in request.resource.data ? request.resource.data.totalQuestions is number : true);
        allow update, delete: if false;
      }
    }
    
    // ---------------------------
    // User Contributions
    // ---------------------------
    match /userContributions/{contributionId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        // Add rules for update/delete if admins need to modify them
        allow update, delete: if false; 
    }


    // ---------------------------
    // Live leaderboard entries
    // /leaderboard_live/{slotId}/entries/{entryId}
    // Anyone can read; only the authenticated user can create/update their own entry.
    // ---------------------------
    match /leaderboard_live/{slotId}/entries/{entryId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId == entryId
        // minimal fields required and types validated
        && ("score" in request.resource.data ? request.resource.data.score is number : true)
        && ("time" in request.resource.data ? request.resource.data.time is number : true);

      // allow update by owner to support merge writes (e.g. set with merge)
      allow update: if request.auth != null
        && request.auth.uid == entryId;

      allow delete: if false;
    }
    
     // ---------------------------
    // Reported Questions
    // ---------------------------
    match /reportedQuestions/{reportId} {
        // Allow authenticated users to create reports
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        // Restrict read/update/delete to admins (via console or cloud functions)
        allow read, update, delete: if false;
    }


    // ---------------------------
    // Default: deny everything else
    // This is a critical security rule.
    // ---------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
