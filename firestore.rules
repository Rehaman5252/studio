
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner of the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can only read and update their own profile
    match /users/{userId} {
      allow read, update, delete: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated();
      
      // Users can read/write their own quiz attempts and daily activity
      match /quizAttempts/{attemptId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      match /dailyActivity/{date} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Any authenticated user can read public questions
    match /questions/{questionId} {
      allow read: if isAuthenticated();
    }
    
    // Any authenticated user can submit a question report
    match /reportedQuestions/{reportId} {
      allow create: if isAuthenticated();
    }

    // Any authenticated user can read the leaderboard
    match /leaderboard/{docId} {
        allow read: if isAuthenticated();
    }
    
    // Any authenticated user can read quiz slots (to check if they played)
    match /quizSlots/{slotId} {
        allow read, write: if isAuthenticated();
    }

    // Deny all other writes by default for safety
    match /{document=**} {
      allow write: if false;
    }
  }
}
