rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read public profile info for leaderboards, but only write to their own doc.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Users can only read and write to their own quiz attempts subcollection.
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Questions are public for all authenticated users to read.
    match /questions/{questionId} {
      allow read: if request.auth != null;
    }

    // Quiz slots are used for uniqueness checks and can be read/written by any authenticated user.
    match /quizSlots/{slotId} {
       allow read, write: if request.auth != null;
    }
    
    // The live leaderboard document can be read by anyone, but only updated by authenticated users (server-side logic).
    match /leaderboard/currentQuiz {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default deny all other paths for security.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
