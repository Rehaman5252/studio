
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 👤 User profile & quiz attempts
    match /users/{userId} {
      // ✅ All users can read profiles (for leaderboard, certificates, etc)
      allow read: if request.auth != null;

      // ✅ Only the user can write to their own profile
      allow write: if request.auth != null && request.auth.uid == userId;

      // 🧠 Subcollection: quizAttempts
      match /quizAttempts/{attemptId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ❓ Public quiz questions
    match /questions/{questionId} {
      allow read: if true;
    }

    // ✅ Shared quizAttempts collection (if used globally)
    match /quizAttempts/{docId} {
      allow read, create: if request.auth != null;
    }

    // 📆 Corrected quiz slot metadata path
    match /quizSlots/{slotId} {
      allow read, write: if request.auth != null;

      match /usedQuestions/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    // 🏆 Corrected leaderboard path (was /liveLeaderboard/)
    match /leaderboard/currentQuiz {
      allow read: if true;
    }

    // 🏆 Leaderboard entry subcollection
    match /leaderboard/currentQuiz/entries/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 🚫 Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
