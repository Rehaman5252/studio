rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Leaderboard collections
    match /leaderboard_live/{slotId}/{entry} {
      allow read: if true;
      allow write: if false; // Only server can write
    }

    // User profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // User-specific subcollections
    match /users/{userId}/{subcollection}/{docId} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global app statistics
    match /globals/{docId} {
        allow read: if true;
        allow write: if false; // Only server can write
    }
    
    // User-submitted content
    match /userContributions/{docId} {
        allow read: if true; // Allow reading for review/display
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
     match /reportedQuestions/{docId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow read: if false; // Should only be readable by backend/admin
    }
  }
}
