
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------
    // Globals stats doc: /globals/stats
    // Allow authenticated users to write limited numeric counters.
    // ---------------------------
    match /globals/stats {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasOnly(["totalQuizzesPlayed", "totalPerfectScores"])
        && request.resource.data.totalQuizzesPlayed is number
        && request.resource.data.totalPerfectScores is number;
    }

    // ---------------------------
    // Users collection (profiles & stats)
    // ---------------------------
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "quizzesPlayed",
          "totalScore",
          "perfectScores",
          "totalRewards",
          "currentStreak",
          "lastStreakTimestamp",
          "noBallCount",
          "lastNoBallTimestamp",
          "updatedAt",
          "name",
          "phone",
          "photoURL",
          "profileCompleted",
          "guidedTourCompleted",
          "dob",
          "gender",
          "occupation",
          "upi",
          "favoriteFormat",
          "favoriteTeam",
          "favoriteCricketer",
          "phoneVerified",
          "referrals"
        ]);

      allow delete: if false;

      // ---------------------------
      // Subcollection: quizAttempts
      // ---------------------------
      match /quizAttempts/{attemptId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
            && request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    // ---------------------------
    // Live leaderboard entries
    // ---------------------------
    match /leaderboard_live/{slotId}/entries/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == entryId
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
