
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Globals collection for app-wide stats
    match /globals/stats {
      // Allow reading by anyone, but writing should be restricted.
      // Since writes happen in a batch triggered by a user, we allow if the user is authenticated.
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profile documents
    match /users/{userId} {
      // Allow anyone to read public user data for leaderboards.
      allow read: if true;
      
      // Allow a user to create their own document and update it.
      // This covers initial user creation and subsequent profile edits.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User's private quiz history
    match /users/{userId}/quizAttempts/{attemptId} {
      // A user can read and write to their own quiz history.
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Live leaderboard entries
    match /leaderboard_live/{slotId}/entries/{userId} {
       // Anyone can read the live leaderboard.
      allow read: if true;
      
      // Only the authenticated user can write their own leaderboard entry.
      // This prevents tampering with others' scores.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
     
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
